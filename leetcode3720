class Solution {
    public String lexGreaterPermutation(String s, String target) {
        int n = s.length();
        int[] freq = new int[26];

        for (char c : s.toCharArray()) {
            freq[c - 'a']++;
        }

        char[] ans = new char[n];

        for (int i = 0; i < n; i++) {
            int t = target.charAt(i) - 'a';

            if (freq[t] > 0) {
                ans[i] = target.charAt(i);
                freq[t]--;
            } else {
                for (int c = t + 1; c < 26; c++) {
                    if (freq[c] > 0) {
                        ans[i] = (char) ('a' + c);
                        freq[c]--;

                        StringBuilder res = new StringBuilder();

                        for (int j = 0; j < i; j++) {
                            res.append(ans[j]);
                        }

                        res.append(ans[i]);

                        for (int j = 0; j < 26; j++) {
                            while (freq[j] > 0) {
                                res.append((char) ('a' + j));
                                freq[j]--;
                            }
                        }

                        return res.toString();
                    }
                }

                break;
            }
        }

        for (int i = n - 1; i >= 0; i--) {
            if (ans[i] == '\0') continue;

            int current = ans[i] - 'a';
            freq[current]++;

            for (int c = current + 1; c < 26; c++) {
                if (freq[c] > 0) {
                    StringBuilder res = new StringBuilder();

                    for (int j = 0; j < i; j++) {
                        res.append(ans[j]);
                    }

                    res.append((char) ('a' + c));
                    freq[c]--;

                    for (int j = 0; j < 26; j++) {
                        while (freq[j] > 0) {
                            res.append((char) ('a' + j));
                            freq[j]--;
                        }
                    }

                    return res.toString();
                }
            }
        }

        return "";
    }
}
